# Copia este fichero a .env y rellénalo. Nunca subas .env a git.
# Lo marcado con (panel) se puede cambiar después desde ⚙ Ajustes; lo que pongas aquí es el valor inicial.

# --- Cuenta del coche (Kia Connect / Hyundai Bluelink / Genesis) ---
KIA_USER=tu_email@ejemplo.com
# Si el login falla con la contraseña correcta, mira docs/conectar-api.md
KIA_PASSWORD=contraseña_o_refresh_token
KIA_PIN=0000
CAR_REGION=1              # 1 Europa, 2 Canadá, 3 EE. UU., 4 China, 5 Australia… (solo probado: 1)
CAR_BRAND=1               # 1 Kia, 2 Hyundai, 3 Genesis (solo probado: 1)
CAR_VIN=                  # solo si la cuenta tiene varios coches: el VIN del que quieres ver

# --- Coche y tarifa (panel) ---
CAR_NAME=Mi EV3
CAR_COLOR=neutro           # neutro, blanco, plata, gris, negro, azul, verde, pistacho, terracota, naranja
BATTERY_KWH=58.3          # batería útil de la ficha técnica
WLTP_KWH_100=15.0         # consumo homologado combinado
PRICE_EUR_KWH=0.15        # precio final de la luz con impuestos
CHARGE_EFFICIENCY=0.90    # red → batería (0,85–0,92 en AC)
CHARGE_MERGE_GAP_MIN=90   # pausas más cortas son la misma carga

# --- Comparación con un coche de combustión (panel) ---
FUEL_TYPE=diesel          # diesel o gasolina
FUEL_PRICE_EUR_L=1.45
FUEL_L_100=5.5            # consumo del coche con el que te comparas

# --- Avisos (panel: umbrales; aquí: canal) ---
LOW_SOC_ALERT=20
KIA_INTERVAL_MIN=30       # mínimo 30: no fuerces lecturas más seguidas
KIA_DOWN_ALERT_MIN=120
KIA_DOWN_REPEAT_H=12
# Opción A: Telegram directo (crea un bot con @BotFather y pon tu chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opción B: webhook propio (POST JSON con topic, urgency, text, event_id). Se usa si no hay Telegram.
NOTIFY_URL=
NOTIFY_SECRET=            # se manda en la cabecera X-Notify-Secret
NOTIFY_DRY_RUN=0

# --- Casa (panel, opcional): las cargas en este radio se marcan «Casa» ---
HOME_LAT=
HOME_LON=
HOME_RADIUS_M=500

# --- Panel web ---
DASH_USER=admin
DASH_PASS=                # obligatoria: 8 caracteres o más, sin ñ ni tildes (install.sh la genera)
API_PORT=8090

# --- Ingesta V2C Trydan desde un agente en casa (opcional) ---
INGEST_TOKEN=             # 16 caracteres o más; vacío = ingesta desactivada (install.sh lo genera)

# --- Control de carga por consumo de la casa (opcional, experimental: docs/control-carga.md) ---
HA_URL=                   # p. ej. http://192.168.1.10:8123; vacío = apagado
HA_TOKEN=                 # token de larga duración de Home Assistant
HA_POWER_ENTITY=          # sensor de potencia de la casa SIN el cargador, en kW
LOAD_HIGH_KW=1.0          # (panel) casa ≥ esto → pausa
LOAD_LOW_KW=0.6           # (panel) casa < esto durante LOAD_LOW_MIN → reanuda
LOAD_LOW_MIN=10
LOAD_PAUSE_MAX_MIN=90     # (panel) pausa máxima
LOAD_MAX_PAUSES=8         # (panel) pausas como mucho por carga
LOAD_CHARGER_MAX_KW=7.4   # (panel) potencia de tu cargador de casa

DB_PATH=miev3.db
TZ=Europe/Madrid          # tu zona horaria: horarios de viajes y resumen, y días locales
